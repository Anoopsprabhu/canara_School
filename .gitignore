# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit keys; .env.example holds names only
.env*
!.env.example

# local SQLite artifacts from the pre-Postgres prototype / stray local runs
/data/

# user-uploaded photos and passbook scans (not committed; keep on the server/volume)
/public/uploads/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/.uploads/
/.superadmin-credentials.txt

# local tool settings
/.claude/

# scanned real member documents used as layout references (personal data)
/1.jpg
/2.jpg
